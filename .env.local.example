# TG Denemeleri - Google Drive salt-okunur bağlantısı
GOOGLE_DRIVE_TG_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Yönetici paneli - GA4 salt-okunur raporları (yalnızca sunucu)
GA4_PROPERTY_ID=552121301
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# WhatsApp duyuru ekleri - Google Drive (OAuth, yalnızca sunucu). Kurulum: docs/WHATSAPP_DRIVE_KURULUM.md
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# 64 onaltılık karakter: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_DRIVE_TOKEN_KEY=
GOOGLE_DRIVE_PICKER_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=
# İsteğe bağlı (varsayılan https://www.sefukoc.com)
GOOGLE_DRIVE_SITE_URL=

# SMS modülü - kurum sağlayıcı kimliklerini şifreleyen anahtar (yalnızca sunucu). Kurulum: docs/SMS_MODULU.md
# 64 onaltılık karakter: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_KIMLIK_ANAHTARI=

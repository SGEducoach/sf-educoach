# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kaynak dokümanlar (müfredat PDF'leri vb.) — kod deposuna dahil değil,
# telif/boyut nedeniyle GitHub'a gitmesin
/dokumanlar/

# İş çıktıları (rapor/afiş/PDF/sunum) — koda ait değil, depoya girmesin.
# 02.10.2026'a kadar 17 dosya (27 MB) buraya işlenmişti; takipten düşürüldü,
# dosyalar diskte kaldı. .vercelignore bu klasörü zaten dışlıyor, yani siteye
# hiç gitmiyorlar.
/output/

# Geçici XLS okuyucu ve yerel SQL doğrulama bağımlılıkları
/tmp/xls-reader/
/tmp/sql-tests/
